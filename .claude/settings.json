{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/loop-core/bin/loop.mjs\" guard-worktree"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "INPUT=\"$(cat)\" && CI_DIR=\"$(printf %s \"$INPUT\" | node \"$CLAUDE_PROJECT_DIR/loop-core/bin/loop.mjs\" stop-hook-ci-dir)\" && cd \"$CI_DIR\" && { npm run ci 1>&2 || exit 2; } && printf %s \"$INPUT\" | node \"$CLAUDE_PROJECT_DIR/loop-core/bin/loop.mjs\" check-actions",
            "timeout": 900
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/loop-core/bin/loop.mjs\" check-actions --on-bash-post"
          }
        ]
      }
    ]
  }
}
